function <<access.private>> meta::relational::functions::pureToSqlQuery::processWindowFrame(frame: meta::pure::functions::relation::Frame[1]):meta::relational::metamodel::Frame[1]
{
   let frameType = $frame->match([
                                   rows: meta::pure::functions::relation::Rows[1] | meta::relational::metamodel::FrameType.ROWS,
                                   range: meta::pure::functions::relation::_Range[1] | meta::relational::metamodel::FrameType.RANGE,
                                   rangeInterval: meta::pure::functions::relation::_RangeInterval[1] | meta::relational::metamodel::FrameType.RANGE
                                 ]); 
   let originalOffsetFrom = $frame.offsetFrom;
   let originalOffsetTo = $frame.offsetTo;
   assert(!(($originalOffsetFrom->instanceOf(meta::pure::functions::relation::FrameIntValue) &&
          $originalOffsetTo->instanceOf(meta::pure::functions::relation::FrameIntValue) &&
          ($originalOffsetFrom->cast(@meta::pure::functions::relation::FrameIntValue).value > $originalOffsetTo->cast(@meta::pure::functions::relation::FrameIntValue).value)) ||
          ($originalOffsetFrom->instanceOf(meta::pure::functions::relation::FrameNumericValue) &&
          $originalOffsetTo->instanceOf(meta::pure::functions::relation::FrameNumericValue) &&
          ($originalOffsetFrom->cast(@meta::pure::functions::relation::FrameNumericValue).value > $originalOffsetTo->cast(@meta::pure::functions::relation::FrameNumericValue).value))),
          | 'Invalid window frame boundary - lower bound of window frame cannot be greater than the upper bound!');
   let offsetFrom = $originalOffsetFrom->match([
                                                  i: meta::pure::functions::relation::FrameIntValue[1] | $i.value->processFrameValue(),
                                                  n: meta::pure::functions::relation::FrameNumericValue[1] | $n.value->processFrameValue(),
                                                  t: meta::pure::functions::relation::FrameIntervalValue[1] | $t->processFrameIntervalValue(),
                                                  u: meta::pure::functions::relation::UnboundedFrameValue[1] | ^meta::relational::metamodel::UnboundedFrameValue(direction = meta::relational::metamodel::FrameValueDirection.PRECEDING)
                                               ]);
   let offsetTo = $originalOffsetTo->match([
                                                  i: meta::pure::functions::relation::FrameIntValue[1] | $i.value->processFrameValue(),
                                                  n: meta::pure::functions::relation::FrameNumericValue[1] | $n.value->processFrameValue(),
                                                  t: meta::pure::functions::relation::FrameIntervalValue[1] | $t->processFrameIntervalValue(),
                                                  u: meta::pure::functions::relation::UnboundedFrameValue[1] | ^meta::relational::metamodel::UnboundedFrameValue(direction = meta::relational::metamodel::FrameValueDirection.FOLLOWING)
                                           ]);
   ^meta::relational::metamodel::Frame(offsetFrom = $offsetFrom, offsetTo = $offsetTo, frameType = $frameType);
}

function meta::relational::functions::pureToSqlQuery::processRelationWindowColumn(
          newFlow:Boolean[1],
          f:FunctionExpression[1],
          partitionKeys:String[*],
          sortInfo:SortInformation[*],
          frame:meta::pure::functions::relation::Frame[0..1],
          name : String[1],
          aggSpec: Any[1],
          currentPropertyMapping:PropertyMapping[*], topQuery:SelectWithCursor[1], operation:SelectWithCursor[1], vars:Map<VariableExpression, ValueSpecification>[1], state:State[1], joinType:JoinType[1], nodeId:String[1], aggFromMap:List<ColumnGroup>[1], context:DebugContext[1], extensions:Extension[*]):RelationalOperationElement[1]
{
   let newColumnName = $name;

   let selectQuery = $topQuery.select->cast(@TdsSelectSqlQuery);

   let shouldIsolateDistinct = $selectQuery.distinct->orElse(false);

   let mainQuery = if($shouldIsolateDistinct, |$selectQuery->isolateTdsSelect($topQuery, $extensions), |$topQuery)->cast(@SelectWithCursor);
   let mainSelect = $mainQuery.select->cast(@TdsSelectSqlQuery);

   assert(!$mainSelect.columns->map(col | $col->extractColumnName())->contains($newColumnName), | 'Attempting to reuse the same column name: '+ $newColumnName);

   let windowElement = $partitionKeys->map(columnName|findAliasOrFail($columnName, $mainSelect).relationalElement);
   let sortElements = $sortInfo->map(si|^SortByInfo(sortByElement=findAliasOrFail($si.column, $mainSelect).relationalElement, 
                                                    sortDirection = if($si.direction.name == meta::pure::tds::SortDirection.DESC.name,| meta::relational::metamodel::SortDirection.DESC,| meta::relational::metamodel::SortDirection.ASC)));
   let newFrame = if($frame->isEmpty(), | [], | $frame->toOne()->processWindowFrame());
   let window = ^meta::relational::metamodel::WindowColumn(
      columnName = $newColumnName,
      func=^DynaFunction(name='PLACEHOLDER'),
      window = ^meta::relational::metamodel::Window(partition=$windowElement, sortBy=$sortElements, frame=$newFrame)
   );

   let func = $aggSpec->match(
      [
        a:meta::pure::metamodel::relation::AggColSpec<Any,Any,Any>[1] | let aggContainer = ^AggContainer(name=$a.name,map=$a.map,reduce=$a.reduce);
                                                                        processRelationMapReduce($aggContainer, true, '', $currentPropertyMapping, $mainQuery, $vars, ^$state(currentWindow=if($newFlow,|$window,|[])), $joinType, $nodeId, $aggFromMap, $context, $extensions);,
        func : meta::pure::metamodel::relation::FuncColSpec<Any,Any>[1] | let aggContainer = ^AggContainer(name=$func.name,map=$func.function);
                                                                          processRelationMap($aggContainer, true, '', $currentPropertyMapping, $mainQuery, $vars, ^$state(currentWindow=if($newFlow,|$window,|[])), $joinType, $nodeId, $aggFromMap, $context, $extensions)->toOne();
      ]
   );

   let windowColumn = ^Alias
                      (
                        name=$newColumnName->addQuotesIfNecessary(),
                        relationalElement = if ($newFlow,|$func,|^$window(func=$func->cast(@DynaFunction)))
                      );

   // Return Type
   let pureType = $aggSpec->match(
                                [
                                  t:TdsOlapAggregation<Any>[1]|$t.func->functionReturnType(),
                                  r:TdsOlapRank<Any>[1]|^GenericType(rawType=Integer),
                                  z:meta::pure::metamodel::relation::FuncColSpec<Any,Any>[1]|$z.function->functionReturnType(),
                                  o:meta::pure::metamodel::relation::AggColSpec<Any,Any,Any>[1]|$o.reduce->functionReturnType()
                                ]
                              );
   let newPath = pair($newColumnName, ^PathInformation(type=$pureType.rawType->toOne(), relationalType= meta::relational::transform::fromPure::pureTypeToDataType($pureType)));

   if ($f->cast(@SimpleFunctionExpression).func == meta::pure::functions::relation::extend_Relation_1___Window_1__AggColSpec_1__Relation_1_,
    | ^$operation(select = ^$mainSelect(columns = $mainSelect.columns->concatenate($windowColumn), paths +=$newPath)),
    | ^$mainSelect(columns = $mainSelect.columns->concatenate($windowColumn), paths +=$newPath)->isolateSubSelectIfNotLastOperation($operation, $f, $state.functionExpressionStack, $extensions);
  );
}

function meta::relational::functions::pureToSqlQuery::extractName(o:Any[0..1]):String[1]
{
   let newColumnName = $o->match([
     str : String[1] | $str,
     agg : meta::pure::metamodel::relation::AggColSpec<Any,Any,Any>[1] | $agg.name,
     func : meta::pure::metamodel::relation::FuncColSpec<Any,Any>[1] | $func.name
   ]);
}

function meta::relational::functions::pureToSqlQuery::processTdsFilter(f:FunctionExpression[1], currentPropertyMapping:PropertyMapping[*], operation:SelectWithCursor[1], vars:Map<VariableExpression, ValueSpecification>[1], state:State[1], joinType:JoinType[1], nodeId:String[1], aggFromMap:List<ColumnGroup>[1], context:DebugContext[1], extensions:Extension[*]):RelationalOperationElement[1]
{
   let mainQuery = processValueSpecification($f.parametersValues->at(0), $currentPropertyMapping, $operation, $vars, $state, $joinType, $nodeId, $aggFromMap, $context, $extensions)->toOne()->cast(@SelectWithCursor);

   let mainSelect = $mainQuery.select;

   if($state.insertDriverTablePkInTempTable->isNotEmpty(),
      | $mainQuery->cast(@SelectWithCursor),
      | let filterCursor = ^$mainQuery(select=^$mainSelect(filteringOperation=[], extraFilteringOperation=[]));
        let res = processValueSpecification($f.parametersValues->at(1), [], $filterCursor, $vars, ^$state(inFilter=true)->withRelationVarScope($f.parametersValues->at(1), $filterCursor), $joinType, $nodeId, $aggFromMap, $context, $extensions)->toOne()->cast(@SelectWithCursor);
        let select = $res.select;
        let mainQueryFilter=$mainSelect.filteringOperation->concatenate($mainQuery.select.extraFilteringOperation)->andFilters($extensions);
        let mainQueryColumns = $mainSelect.columns;

        let finalColumns = $mainQueryColumns->map(c|
                                                  $c->match(
                                                     [
                                                        w:WindowColumn[1]|if(!$select.columns->extractTableAliasColumns().column.name->contains($w.columnName) ,|$w,|$select.columns->filter(c|$c->extractTableAliasColumns().column.name==$w.columnName)->toOne()),
                                                        a:Alias[1]| let col = $select.columns->filter(c|$c->instanceOf(Alias) && $c->cast(@Alias).name==$a.name);
                                                                    $col->isEmpty()->if(|$a,|$col);,
                                                        r:RelationalOperationElement[1]| $r
                                                     ]
                                                  ));
        let queryRootMutated = !$mainSelect->rootIsSubQuery() && $select->rootIsSubQuery();
        let placeNestedFilters = {select:SelectSQLQuery[1]|let havingFilter=$select.data->toOne().alias.relationalElement->cast(@SelectSQLQuery).filteringOperation;
                                                           let filter = $havingFilter->concatenate($mainSelect.havingOperation)->andFilters($extensions);
                                                           let newSelect = nestFilters($select,$mainQueryFilter,$filter);
                                                           ^$newSelect(columns=$finalColumns, filteringOperation=$select.filteringOperation);
                                 };
        let placeRootFilters = {select: SelectSQLQuery[1]|let filteringOperation = $select.filteringOperation;
                                                          let filter = $filteringOperation->concatenate($mainSelect.havingOperation)->concatenate($mainSelect.qualifyOperation)->andFilters($extensions);
                                                          if ($filteringOperation->getWindowColsFromOperation()->isEmpty(),
                                                            | ^$select(columns=$finalColumns, filteringOperation=$mainQueryFilter, havingOperation=$filter),
                                                            | ^$select(columns=$finalColumns, filteringOperation=$mainQueryFilter, qualifyOperation=$filter)
                                                          );
                                };
        let nestMainFilter = {select: SelectSQLQuery[1]|let newSelect = nestFilters($select,$mainQueryFilter,[]);
                                                        ^$newSelect(columns=$finalColumns, filteringOperation=$select.filteringOperation->concatenate($newSelect.filteringOperation)->andFilters($extensions));
                              };
        let placeMainFilterAtRoot ={select: SelectSQLQuery[1] | let filter = $select.filteringOperation->concatenate($mainQueryFilter)->andFilters($extensions);
                                                                ^$select(columns=$finalColumns, filteringOperation=$filter);
                                   };

        if($queryRootMutated,| let updatedSelect = if(!$mainSelect.groupBy->isEmpty() || !$mainSelect.pivot->isEmpty(),
                                                    | $placeNestedFilters->eval($select),
                                                    | $nestMainFilter->eval($select));
                               ^$res(select = $updatedSelect);

                            ,| let updatedSelect = if(!$mainSelect.groupBy->isEmpty() || !$mainSelect.pivot->isEmpty() || !$select.filteringOperation->getWindowColsFromOperation()->isEmpty(),
                                                    | $placeRootFilters->eval($select),
                                                    | $placeMainFilterAtRoot->eval($select));

                               ^$res(select = $updatedSelect,
                                     currentTreeNode = if($mainQuery.currentTreeNode->isNotEmpty(),| $mainQuery.currentTreeNode->toOne()->findOneNode($mainSelect.data->toOne(), $res.select.data->toOne()), |[]),
                                     positionBeforeLastApplyJoinTreeNode = if($mainQuery.positionBeforeLastApplyJoinTreeNode->isNotEmpty(),| $mainQuery.positionBeforeLastApplyJoinTreeNode->toOne()->findOneNode($mainSelect.data->toOne(), $res.select.data->toOne()), |[]));

           );
   );
}

function meta::relational::functions::pureToSqlQuery::rootIsSubQuery(query: SelectSQLQuery[1]): Boolean[1]
{
   $query.data->toOne().alias.relationalElement->instanceOf(SelectSQLQuery)
