      | ^meta::relational::metamodel::FrameCurrentRowValue(),
      | if ($v < 0,
            | ^meta::relational::metamodel::FrameIntervalValue(value = ^Literal(value = $v->abs()), direction = meta::relational::metamodel::FrameValueDirection.PRECEDING, durationUnit = $i.durationUnit),
