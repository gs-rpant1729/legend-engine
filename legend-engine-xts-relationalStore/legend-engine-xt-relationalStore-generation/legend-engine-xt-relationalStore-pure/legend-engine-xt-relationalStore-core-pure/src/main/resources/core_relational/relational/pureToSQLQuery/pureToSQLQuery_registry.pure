// Dispatcher for flatten_T_MANY__ColSpec_1__Relation_1_ — detects whether this is a cross-store (from non relational source) variant temp-table flatten (source is fromJson()->toMany(@Variant) chain or PlanVarPlaceHolder) or a regular relational lateral flatten (source is a relational expression).
// Cross-store case (from non relational source): generate SELECT from the pre-materialized variant temp table.
// Relational case: delegate to the existing processVariantFlatten (LATERAL FLATTEN SQL).
function meta::relational::functions::pureToSqlQuery::processFlattenOrVariantTempTable(fe:FunctionExpression[1], currentPropertyMapping:PropertyMapping[*], operation:SelectWithCursor[1], vars:Map<VariableExpression, ValueSpecification>[1], state:State[1], joinType:JoinType[1], nodeId:String[1], aggFromMap:List<ColumnGroup>[1], context:DebugContext[1], extensions:Extension[*]):RelationalOperationElement[1]
{
   let isVariantTempTableCase = $fe->meta::relational::mutation::executionPlan::isVariantFlattenSource();
   if($isVariantTempTableCase,
      | processWriteToVariantTempTable($fe, $currentPropertyMapping, $operation, $vars, $state, $joinType, $nodeId, $aggFromMap, $context, $extensions),
      | processVariantFlatten($fe, $currentPropertyMapping, $operation, $vars, $state, $joinType, $nodeId, $aggFromMap, $context, $extensions)
   );
}

function meta::relational::functions::pureToSqlQuery::processWriteToVariantTempTable(fe:FunctionExpression[1], currentPropertyMapping:PropertyMapping[*], operation:SelectWithCursor[1], vars:Map<VariableExpression, ValueSpecification>[1], state:State[1], joinType:JoinType[1], nodeId:String[1], aggFromMap:List<ColumnGroup>[1], context:DebugContext[1], extensions:Extension[*]):RelationalOperationElement[1]
{
   let colName  = $fe.parametersValues->at(1)->meta::relational::mutation::executionPlan::extractVariantColName();
   let tempName = $fe->meta::relational::mutation::executionPlan::extractVariantWriteTempName();
   let variantColumn = ^Column(name = $colName, type = ^meta::relational::metamodel::datatype::SemiStructured());
   let tempTable = ^Table(name = $tempName,
                          schema = ^Schema(name = 'default', database = ^Database(name = 'TempTableDb')),
                          columns = $variantColumn,
                          temporaryTable = true);
   let tableAlias = ^TableAlias(name = 'writeVariant' + buildNodeId($nodeId, ''), relationalElement = $tempTable);
   ^$operation(
      select = ^TdsSelectSqlQuery(
         columns = [^Alias(name = $colName->addQuotesIfNecessary(), relationalElement = ^TableAliasColumn(alias = $tableAlias, column = $variantColumn))],
         data    = ^RootJoinTreeNode(alias = $tableAlias)
      )
   );
}
