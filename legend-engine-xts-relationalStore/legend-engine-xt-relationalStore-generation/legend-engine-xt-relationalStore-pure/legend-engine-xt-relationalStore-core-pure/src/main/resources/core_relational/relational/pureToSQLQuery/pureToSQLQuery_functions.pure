function <<access.private>> meta::relational::functions::pureToSqlQuery::processFrameValue(v: Number[1]):meta::relational::metamodel::FrameValue[1]
{
   if($v == 0,
      | ^meta::relational::metamodel::FrameCurrentRowValue(),
      | if ($v < 0,
            | ^meta::relational::metamodel::FrameLiteralValue(value = ^Literal(value = $v->abs()), direction = meta::relational::metamodel::FrameValueDirection.PRECEDING),
            | ^meta::relational::metamodel::FrameLiteralValue(value = ^Literal(value = $v->abs()), direction = meta::relational::metamodel::FrameValueDirection.FOLLOWING)));
}

function <<access.private>> meta::relational::functions::pureToSqlQuery::processFrameIntervalValue(i: meta::pure::functions::relation::FrameIntervalValue[1]):meta::relational::metamodel::FrameValue[1]
{
   let v = $i.value;
