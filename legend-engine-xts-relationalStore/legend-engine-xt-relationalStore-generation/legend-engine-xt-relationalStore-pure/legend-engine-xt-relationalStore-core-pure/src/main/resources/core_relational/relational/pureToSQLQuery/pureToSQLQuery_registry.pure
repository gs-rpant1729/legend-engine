Class meta::relational::functions::pureToSqlQuery::ProcessingSide
{
   source : Boolean[1];
   target : Boolean[1];
}

function meta::relational::functions::pureToSqlQuery::findSupportedFunction(fe:FunctionExpression[1], vars:Map<VariableExpression, ValueSpecification>[1], state: State[1]):meta::pure::metamodel::function::Function<{FunctionExpression[1], PropertyMapping[0..1], SelectWithCursor[1], Map<VariableExpression, ValueSpecification>[1], State[1], JoinType[1], String[1], List<ColumnGroup>[1], DebugContext[1], Extension[*]->RelationalOperationElement[1]}>[0..1]
{
  // Two-tier dispatch:
  //   Tier 1: context registry — a single list of (predicate, handler) pairs per FE key
  //           evaluated in registration order. Predicates take {fe, vars, state}; predicates
  //           that don't need vars/state simply ignore them (see the four AST-only entries
  //           for `at`, `match`, `typeName`, `new(Pair)` which delegate to fe-only helpers).
  //           Context-only functions carry a `{fe, vars, state | true}` catchall at the
  //           tail of their list pointing at `processContextOnlyFunctionFallback`, so a
  //           mis-claim at clustering time fails loudly here rather than silently.
  //   Tier 2: static `supportedFunctions` — real processor for the FE.
  // Within tier 1 the first matching pair (in registration order) wins.
  let ctxPairs = $state.contextBasedSupportedFunctions->get($fe.func).values
                        ->map(cb | pair(|$cb.first->eval($fe, $vars, $state), |$cb.second));
  if(
    $ctxPairs,
    | // Tier 1 missed — fall back to the static map.
      $state.supportedFunctions->get($fe.func)
  );
}

function meta::relational::functions::pureToSqlQuery::isFunctionSupportedForCluster(fe:FunctionExpression[1], state: State[1]):Boolean[1]
{
  // Clustering-time membership check used by the relational StoreContract.supports
  // (see legend-engine-xt-relationalStore-core-pure/.../contract/storeContract.pure).
  //
  // The unified `contextBasedSupportedFunctions` map is intentionally NOT consulted
  // here: its predicates take the full {fe, vars, state} signature and would read an
  // empty inScopeVars / [] disableAutoFlatten / empty functionReferenceScope from the
  // defaultState stub, giving wrong answers (with surprising println / fail side-effects).
  //
  // Instead, cluster-time claim decisions are made against a dedicated registry
  // `getClusteringContextPredicates` whose predicates take only the FunctionExpression
  // — the narrower type statically enforces state-safety at this call site. That
  // registry carries three flavours of entry:
  //   1. Fe-only applicability predicates such as `canProcessAt` — the cluster claims
  //      the FE only when the AST-shape predicate fires true, letting other clusters
  //      pick up the FE when it fires false. Example: `->at(0)` on an already-routed
  //      (non-`NoSet`) `RoutedValueSpecification` correctly defers to the platform
  //      cluster (see test `testPlatformExpressionDependencyOnAFromExpression`).
  //   2. Unconditional-true predicates for context-only functions whose sole handler
  //      lives in the unified context registry (today: `fold`, `isNotEmpty_Any_MANY`,
  //      `indexOf`, `instanceOf`) — these need to be claimed at clustering, and any
  //      mis-claim then falls through to `processContextOnlyFunctionFallback` at
  //      PureToSQL time and fails loudly.
  //   3. (Reserved for future) any other fe-only cluster-claim predicate that must
  //      not be evaluated against a stub State.
  $state.supportedFunctions->get($fe.func)->isNotEmpty()
  || meta::relational::functions::pureToSqlQuery::getClusteringContextPredicates()->get($fe.func).values
      ->exists(pred | $pred->eval($fe));
}

function meta::relational::functions::pureToSqlQuery::getGroupBy(viewSpecification:RelationalMappingSpecification[1]):GroupByMapping[0..1]
{
    $viewSpecification->match(
                            [
                                r   : RootRelationalInstanceSetImplementation[1] | $r->resolveGroupBy(),
                                rms : RelationalMappingSpecification[1]          | $rms.groupBy
                            ]
                        );
}

function meta::relational::functions::pureToSqlQuery::getFilter(viewSpecification:RelationalMappingSpecification[1]):FilterMapping[0..1]
{
    $viewSpecification->match(
                            [
                                r   : RootRelationalInstanceSetImplementation[1] | $r->resolveFilter(),
                                rms : RelationalMappingSpecification[1]          | $rms.filter
                            ]
                        );
}

function meta::relational::functions::pureToSqlQuery::getDistinct(viewSpecification:RelationalMappingSpecification[1]):Boolean[0..1]
{
    $viewSpecification->match(
                            [
                                r   : RootRelationalInstanceSetImplementation[1] | $r->resolveDistinct(),
                                rms : RelationalMappingSpecification[1]          | $rms.distinct
                            ]
                        );
}

function  meta::relational::functions::pureToSqlQuery::getRelationalTypeFromRelationalPropertyMapping(r:RelationalOperationElement[1]):meta::relational::metamodel::datatype::DataType[0..1]
{
    $r->match([t:TableAliasColumn[1]|$t.column.type,
               c:Column[1]|$c.type,
               a:Any[1] | []// TOFIX - support all possible Types  fail($a->type().name ->toOne() + ' is not supported yet')
                  ])->cast(@meta::relational::metamodel::datatype::DataType);

}

function meta::relational::functions::pureToSqlQuery::genericTypeToDataType(genericType:GenericType[1], mult: Multiplicity[1]):meta::relational::metamodel::datatype::DataType[1]
{
    let path = $genericType.rawType.name->toOne();
    let variables = $genericType.typeVariableValues;
    let type = if (
        [
            pair(|$path == 'Boolean', |^meta::relational::metamodel::datatype::Boolean()),
            pair(|$path == 'Integer', |^meta::relational::metamodel::datatype::BigInt()),
            pair(|$path == 'Float', |^meta::relational::metamodel::datatype::Double()),
            pair(|$path == 'Byte', |^meta::relational::metamodel::datatype::Binary(size=10000)),
            // pair(|$path == 'StrictTime', |fail('not supported yet!')),
            pair(|$path == 'Decimal', |^meta::relational::metamodel::datatype::Decimal(precision=32, scale=16)),
            pair(|$path == 'String', |^meta::relational::metamodel::datatype::Varchar(size=1024)),
            pair(|$path == 'DateTime', |^meta::relational::metamodel::datatype::Timestamp()),
            pair(|$path == 'Number', |^meta::relational::metamodel::datatype::Decimal(precision=32, scale=16)),
            pair(|$path == 'Date', |^meta::relational::metamodel::datatype::Timestamp()),

            pair(|$path == 'Nil', |^meta::relational::metamodel::datatype::SemiStructured()),
            pair(|$path == 'List', |^meta::relational::metamodel::datatype::Array(type = $genericType.typeArguments->at(0)->genericTypeToDataType(ZeroOne))),
            pair(|$path == 'Map' && $genericType.typeArguments->at(0).rawType == String, |^meta::relational::metamodel::datatype::Object(keyType = $genericType.typeArguments->at(0)->genericTypeToDataType(ZeroOne), valueType = $genericType.typeArguments->at(1)->genericTypeToDataType(ZeroOne))),
            pair(|$path == 'Pair' && $genericType.typeArguments->at(0).rawType == String, |^meta::relational::metamodel::datatype::Object(keyType = $genericType.typeArguments->at(0)->genericTypeToDataType(ZeroOne), valueType = $genericType.typeArguments->at(1)->genericTypeToDataType(ZeroOne))),
            pair(|$path == 'Variant' || ($path->in(['Map', 'Pair', 'List', 'Any'])->not() && $genericType.rawType->toOne()->instanceOf(Class)), |^meta::relational::metamodel::datatype::SemiStructured()),
            pair(|$genericType.rawType->toOne()->instanceOf(Enumeration), |^meta::relational::metamodel::datatype::Varchar(size=1024)),

            pair(|$path == 'BigInt', |^meta::relational::metamodel::datatype::BigInt()),
            pair(|$path == 'StrictDate', |^meta::relational::metamodel::datatype::Date()),
            pair(|$path == 'Numeric', |^meta::relational::metamodel::datatype::Decimal(precision=$variables->at(0)->cast(@InstanceValue)->evaluateAndDeactivate().values->toOne()->cast(@Integer), scale=$variables->at(1)->cast(@InstanceValue)->evaluateAndDeactivate().values->toOne()->cast(@Integer))),
            pair(|$path == 'Double', |^meta::relational::metamodel::datatype::Double()),
            pair(|$path == 'Float4', |^meta::relational::metamodel::datatype::Float()),
            pair(|$path == 'Int', |^meta::relational::metamodel::datatype::Integer()),
            pair(|$path == 'SmallInt', |^meta::relational::metamodel::datatype::SmallInt()),
            pair(|$path == 'Timestamp', |^meta::relational::metamodel::datatype::Timestamp()),
            pair(|$path == 'TinyInt', |^meta::relational::metamodel::datatype::TinyInt()),
            // pair(|$path == 'UBigInt', |fail('not supported yet!')),
            // pair(|$path == 'UInt', |fail('not supported yet!')),
            // pair(|$path == 'USmallInt', |fail('not supported yet!')),
            // pair(|$path == 'UTinyInt', |fail('not supported yet!')),
            pair(|$path == 'Varchar', |^meta::relational::metamodel::datatype::Varchar(size=$variables->cast(@InstanceValue)->evaluateAndDeactivate().values->toOne()->cast(@Integer)))
        ],
        | fail ($genericType->printGenericType(false) + ' is not managed yet!');
    )->cast(@meta::relational::metamodel::datatype::DataType);

    if ($mult->isToMany(), |^meta::relational::metamodel::datatype::Array(type = $type), |$type);
}

function meta::relational::functions::pureToSqlQuery::replaceAliasInSelectWithCursor(srcOperation:SelectWithCursor[1], oldNode:RelationalTreeNode[1], newAlias:TableAlias[1]):SelectWithCursor[1]
{
   if ($oldNode.alias == $newAlias,
       | $srcOperation,
       | let newNode = ^$oldNode(alias = $newAlias);

         let select = $srcOperation.select;
         let data = $select.data->toOne();
         let updatedData = $data->replaceTreeNode($oldNode, $newNode)->cast(@RootJoinTreeNode);
         let updatedSelect = ^$select(data = $updatedData);

         let currentTreeNode = $srcOperation.currentTreeNode;
         let updatedCurrentTreeNode = if ($currentTreeNode->isEmpty(),| [],| $currentTreeNode->toOne()->replaceTreeNode($oldNode, $newNode))->cast(@RelationalTreeNode);

         let positionBeforeLastApplyJoinTreeNode = $srcOperation.positionBeforeLastApplyJoinTreeNode;
         let updatedPositionBeforeLastApplyJoinTreeNode = if ($positionBeforeLastApplyJoinTreeNode->isEmpty(),| [],| $positionBeforeLastApplyJoinTreeNode->toOne()->replaceTreeNode($oldNode, $newNode))->cast(@RelationalTreeNode);

         ^$srcOperation(currentTreeNode = $updatedCurrentTreeNode, select = $updatedSelect, positionBeforeLastApplyJoinTreeNode = $updatedPositionBeforeLastApplyJoinTreeNode);
   );
}

